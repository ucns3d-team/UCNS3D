! =============================================================================
! UCNS3D.DAT - main solver input file
! Values are read positionally; keep data lines in this order.
! dimension statistics code_profile
3  0  -1  ! dimension: 2/3; statistics: 0 off, 1 on; code_profile: 0/888 default, 9 robust, 91 robust-LU-SGS, 100-102 DG, 999 default-no-CFL-ramp
! -----------------------------------------------------------------------------
! governing_equations initcond
1  4  ! governing_equations: 1 Navier-Stokes, 2 Euler, 3 linear-sinewave, 4 linear-step; initcond: case/profile id
! -----------------------------------------------------------------------------
! turbulence coupled_turbulence passive_scalars
0  0  0  ! turbulence: 0 off, 1 on; coupled_turbulence: 0 decoupled, 1 coupled; passive_scalars: number of scalar equations
! -----------------------------------------------------------------------------
! =============================================================================
! CONDITIONS
! =============================================================================
! Freestream / initial field
! density u_velocity v_velocity w_velocity pressure mach_initial
1.225  140.0  0.0  0.0  101325  0.3  ! fields: rho, u, v, w, static_pressure; optional Mach; pressure=-1 uses rho/gamma
! -----------------------------------------------------------------------------
! angle_of_attack vector_x vector_y vector_z
0.0  1.0  1.0  0.0  ! fields: angle_of_attack, rotation/reference vector components in xy/xz plane
! -----------------------------------------------------------------------------
! gamma Prandtl Reynolds characteristic_length
1.4  0.72  113000  1.0  ! fields: gamma, Prandtl, Reynolds, characteristic_length
! -----------------------------------------------------------------------------
! =============================================================================
! DISCRETISATION
! =============================================================================
! scheme riemann spatial_order limiter polynomial_basis
2  9  2  1  1  ! scheme: 1 linear, 2 MUSCL-TVD, 3 WENO; riemann: 1 HLLC, 2 Rusanov, 3 Roe, 4/5 Roe-family, 9 outlet-aware; order: 1-7; limiter: 1-7; poly: 1 generic, 2 Legendre
! -----------------------------------------------------------------------------
! weno_variable stencil_option weight_normalisation central_weight
1  5  1  10e4  ! weno_variable: 1 conserved, 2 characteristic, 3 primitive; stencil_option: 0-5; weight_norm: 0 off, 1 on; central_weight: lambda
! -----------------------------------------------------------------------------
! temporal_order CFL timestep dts_iterations residual_threshold
3  0.6  0.002  30  0.0001  ! temporal_order: 1-4 RK, 5 RK-LTS, 10 implicit-BE, 11 implicit-2nd; fields: CFL, timestep, DTS iterations, residual threshold
! -----------------------------------------------------------------------------
! periodic_flag subsonic_boundary_flag scaling_factor
0  1  1.0  ! periodic_flag: 0 non-periodic, 1 periodic; boundary_type: 0 supersonic, 1 subsonic; scaling_factor: numeric
! -----------------------------------------------------------------------------
! gradient_method low_mach_flag
0  0  ! gradient_method: 0 least-squares, 1 Green-Gauss; low_mach_flag: 0 off, 1 on
! -----------------------------------------------------------------------------
! =============================================================================
! I/O OPERATIONS
! =============================================================================
! total_simulation_time max_iterations wall_clock_limit_seconds
0.1  10000000  81000  ! fields: total_simulation_time, max_iterations, wall_clock_limit_seconds
! -----------------------------------------------------------------------------
! output_format output_rate restart_rate average_output_rate write_stencils
5  1000  10000  50000  1  ! output_format: 0 Tecplot ASCII, 1 Tecplot binary, 2 ParaView binary, ParaView binary 5, 6 partitioned; rates: output/restart/average; write_stencils: 0/1
! -----------------------------------------------------------------------------
! averaging
0  ! averaging: 0 off, 1 on
! -----------------------------------------------------------------------------
! compute_forces force_frequency write_shear_stress
1  300  1  ! compute_forces: 0 off, 1 on; force_frequency: iterations; write_shear_stress: 0 off, 1 on
! -----------------------------------------------------------------------------
! restart_turbulence restart_unsteady restart_passive previous_turbulence_model
0  0  0  0  ! restart_turbulence/restart_unsteady/restart_passive: 0 no, 1 yes; previous_turbulence_model: 0 none, 1 SA, 2 k-omega SST
! -----------------------------------------------------------------------------
! =============================================================================
! PROBES
! =============================================================================
! number_of_probes
0  ! number_of_probes: 0 none, >0 reads that many coordinate lines below
! probe_coordinates x y z - used only if number_of_probes > 0
0.50001  0.50001  0.0  ! probe coordinates: x y for 2D, x y z for 3D; ignored when number_of_probes=0
