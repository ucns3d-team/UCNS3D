# Cancel Make's built-in Modula-2 rule (.mod → .o via m2c)
# which conflicts with Fortran .mod files.
%.o : %.mod

# Wrap every compiler/linker invocation with timing.
# Prints a single line: "[  12.3s] ftn ... file.f90"
# Override with TIME= on the command line to disable.
TIME ?= /usr/bin/time -f "  [%es] %C"

all: build_start ucns3d_p build_end

# Phony targets to print total wall-clock time
BUILD_START_FILE := .build_start_time
.PHONY: build_start build_end
build_start:
	@date +%s > $(BUILD_START_FILE)
	@echo "=== Build started at $$(date) ==="

build_end: ucns3d_p
	@echo "=== Build finished at $$(date) ==="
	@if [ -f $(BUILD_START_FILE) ]; then \
	  start=$$(cat $(BUILD_START_FILE)); \
	  end=$$(date +%s); \
	  elapsed=$$((end - start)); \
	  echo "=== Total build time: $${elapsed}s ==="; \
	  rm -f $(BUILD_START_FILE); \
	fi

# Object files for the main executable (everything except reconstruct_p)
MAIN_OBJECTS = mpi_p.o declarations.o parameters.o translate.o grid_t.o \
    flow_operations.o io.o memory.o communications.o der_r.o parts.o svd.o \
    grid_p.o basis.o local_pt.o riemann.o flux_p.o profile.o init_p.o \
    bc_p.o matrix.o gradients.o prestore.o source.o implicit_fluxes.o \
    implicit_time.o mood.o time_p.o dg_functions.o main.o

# Shared library for the reconstruction module.
# GPU device code (OpenMP target offload) requires all referenced symbols
# resolved at shared-library link time, so we include the dependency objects
# that contain !$omp declare target routines/data alongside reconstruct_p.
# All objects are compiled with PIC (flag is in FFLAGS).
RECON_LIB = librecon.$(SHLIB_EXT)
RECON_DEP_OBJECTS = declarations.o der_r.o grid_t.o grid_p.o basis.o \
    gradients.o flow_operations.o

$(RECON_LIB): reconstruct_p.o $(RECON_DEP_OBJECTS)
	$(TIME) $(LD) $(FFLAGS) $(SHLIB_FLAGS) -o $@ $^

ucns3d_p: $(MAIN_OBJECTS) $(RECON_LIB)
	$(TIME) $(LD) $(FFLAGS) $(OFLAGS) -o ucns3d_p $(MAIN_OBJECTS) -L. -lrecon $(RPATH_FLAG) $(LIBS)

GPU_MAX_OBJECTS = $(MAIN_OBJECTS) reconstruct_p.o
$(GPU_MAX_OBJECTS): $(GPU_MAX_DEPS)

# -----------------------------------------------------------------------------
# Stamp-file rules: each .f90 compilation produces both a .o and a .mod file.
# Using stamp files ensures the recipe runs exactly once even on Make < 4.3
# (which lacks grouped-target &: support).
# -----------------------------------------------------------------------------

main.o: mpiinfo.mod declaration.mod translate.mod parameters.mod memory.mod communications.mod io.mod partition.mod library.mod transform.mod fluxes.mod initialisation.mod boundary.mod advance.mod recon.mod local.mod profile.mod flow_operations.mod gradients.mod basis.mod prestore.mod riemann.mod source.mod implicit_time.mod implicit_fluxes.mod moodr.mod 
	$(TIME) $(F90) $(FFLAGS)  -c	main.f90

.mpi_p.stamp : mpi_p.f90
	$(TIME) $(F90) $(FFLAGS)  -c    mpi_p.f90
	@touch $@
mpiinfo.mod mpi_p.o : .mpi_p.stamp

.declarations.stamp : declarations.f90
	$(TIME) $(F90) $(FFLAGS)  -c    declarations.f90
	@touch $@
declaration.mod declarations.o : .declarations.stamp

